<!-- Navbar -->
   <div class="navbar navbar-fixed-top">
      <div class="navbar-inner">
[% IF page.mode != 'static'; href = links.base_uri -%]
[% ELSE; href = uri_for( 'index' ); END -%]
[%       Link( href, 'brand pull-left', loc( config.title ) )-%]
[% IF page.authenticated -%]
         <div class="icon-container pull-right">
[%    text = '<span class="tools_icon"></span>' -%]
[%    tip  = loc( 'Configure user profile' ) -%]
[%    LinkWithTips( '#', 'windows', text, page.hint, tip, 'profile-user' ) -%]
         </div>
[% END -%]
         <p class="navbar-text pull-right">[% loc( 'Generated by' ) -%]&nbsp;
[% IF page.mode != 'static' -%]
[%    href = links.help; tip = loc( 'Help pages for the application' ) -%]
[% ELSE -%]
[%    href = config.mount_point _ '/'; tip = loc( 'Site Description' ) -%]
[% END -%]
[%          LinkWithTips( href, 'windows', config.appclass, page.hint, tip ) -%]
            &nbsp;v[% page.application_version %]
         </p>
      </div>
   </div>
