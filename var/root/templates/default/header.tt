               <!-- Header -->
               <div class="page-header">
                  <h1>[% IF page.parent; loc( page.parent ) _ ' - '; END -%]
                      [%- loc( page.title ) %]</h1>
[% IF page.modified -%]
                  <span class="pull-left">
                     [%- time2str( '%A, %B %e, %Y', page.modified ) %],
                     [%- time2str( '%l:%M %p', page.modified ) %]</span>
[% END -%]
[% IF page.author != config.author -%]
                  <span class="pull-right">
                     [%- page.author %]</span>
[% END -%]
               </div>
